+def dump_startup_diagnostics(path: str) -> None:
+    """Write a snapshot of the runtime environment for support bundles."""
+    snapshot = {
+        "python_version": sys.version,
+        "pid": os.getpid(),
+        "environ": dict(os.environ),
+    }
+    with open(path, "w", encoding="utf-8") as fh:
+        json.dump(snapshot, fh, indent=2)
