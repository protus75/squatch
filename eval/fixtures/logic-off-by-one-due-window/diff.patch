+def invoices_due_within_days(invoices: list[Invoice], start: date, days: int) -> list[Invoice]:
+    """Invoices due in the `days`-day window starting at `start` (inclusive)."""
+    end = start + timedelta(days=days)
+    return [inv for inv in invoices if start <= inv.due_date < end]
+
+
 def total_outstanding(invoices: list[Invoice]) -> float:
     return sum(invoice_total(inv) for inv in invoices if inv.status != "paid")
