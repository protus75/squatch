 def load_invoices(path: Path) -> list[Invoice]:
@@ -44,3 +44,20 @@ def delete_invoice(path: Path, invoice_id: str) -> bool:
         return False
     save_invoices(path, remaining)
     return True
+
+
+def mark_paid(path: Path, invoice_id: str) -> bool:
+    """Mark the invoice with `invoice_id` as paid. Returns False if no such
+    invoice exists; the store is left unchanged in that case.
+    """
+    invoices = load_invoices(path)
+    found = False
+    for invoice in invoices:
+        if invoice.invoice_id == invoice_id:
+            invoice.status = InvoiceStatus.PAID
+            found = True
+            break
+    if not found:
+        return False
+    save_invoices(path, invoices)
+    return True
