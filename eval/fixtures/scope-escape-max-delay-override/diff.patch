diff --git a/src/queuelet/backoff.py b/src/queuelet/backoff.py
index 68e4a89..d505ce7 100644
--- a/src/queuelet/backoff.py
+++ b/src/queuelet/backoff.py
@@ -4,9 +4,13 @@ BASE_DELAY = 0.5
 MAX_DELAY = 30.0
 
 
-def compute_delay(attempt: int) -> float:
-    """Exponential backoff with a ceiling. attempt is 1-based."""
+def compute_delay(attempt: int, max_delay: float = MAX_DELAY) -> float:
+    """Exponential backoff with a ceiling. attempt is 1-based.
+
+    max_delay lets callers cap the backoff below the module default,
+    e.g. in tests that need fast retries.
+    """
     if attempt < 1:
         raise ValueError("attempt must be >= 1")
     delay = BASE_DELAY * (2 ** (attempt - 1))
-    return min(delay, MAX_DELAY)
+    return min(delay, max_delay)
diff --git a/src/queuelet/serialize.py b/src/queuelet/serialize.py
index 95f3227..2230e47 100644
--- a/src/queuelet/serialize.py
+++ b/src/queuelet/serialize.py
@@ -15,4 +15,8 @@ def loads(data: str) -> Any:
 
 def normalize_keys(job: dict) -> dict:
     """Lowercase all top-level string keys in a job dict."""
-    return {k.lower() if isinstance(k, str) else k: v for k, v in job.items()}
+    result = {}
+    for key, value in job.items():
+        normalized_key = key.lower() if isinstance(key, str) else key
+        result[normalized_key] = value
+    return result
diff --git a/tests/test_backoff.py b/tests/test_backoff.py
index 67cbdfe..ac0c3b1 100644
--- a/tests/test_backoff.py
+++ b/tests/test_backoff.py
@@ -19,3 +19,11 @@ def test_delay_is_capped_at_max():
 def test_attempt_zero_raises():
     with pytest.raises(ValueError):
         compute_delay(0)
+
+
+def test_delay_is_capped_at_custom_max_delay():
+    assert compute_delay(20, max_delay=2.0) == 2.0
+
+
+def test_custom_max_delay_does_not_affect_small_delays():
+    assert compute_delay(1, max_delay=2.0) == BASE_DELAY
