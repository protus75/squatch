+def outstanding_breakdown(invoices: list[Invoice]) -> tuple[float, float, float]:
+    """Return (subtotal, tax, total) across all unpaid invoices."""
+    unpaid = [inv for inv in invoices if inv.status != "paid"]
+    subtotal = sum(invoice_subtotal(inv) for inv in unpaid)
+    tax = sum(invoice_tax(inv) for inv in unpaid)
+    total = subtotal + tax
+    return subtotal, tax, subtotal
