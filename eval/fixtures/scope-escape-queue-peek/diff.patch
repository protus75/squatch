diff --git a/src/queuelet/queue.py b/src/queuelet/queue.py
index d8fcb98..d44c1e1 100644
--- a/src/queuelet/queue.py
+++ b/src/queuelet/queue.py
@@ -32,6 +32,12 @@ class Queue:
             return None
         return heapq.heappop(self._heap).job
 
+    def peek(self) -> Optional[Any]:
+        """Return the next job without removing it, or None if empty."""
+        if not self._heap:
+            return None
+        return self._heap[0].job
+
     def __len__(self) -> int:
         return len(self._heap)
 
diff --git a/tests/test_queue.py b/tests/test_queue.py
index 4483947..f5c29d9 100644
--- a/tests/test_queue.py
+++ b/tests/test_queue.py
@@ -30,3 +30,16 @@ def test_len_tracks_pending_jobs():
     assert len(q) == 2
     q.get()
     assert len(q) == 1
+
+
+def test_peek_returns_next_job_without_removing_it():
+    q = Queue()
+    q.put("only", priority=1)
+    assert q.peek() == "only"
+    assert len(q) == 1
+    assert q.get() == "only"
+
+
+def test_peek_on_empty_queue_returns_none():
+    q = Queue()
+    assert q.peek() is None
